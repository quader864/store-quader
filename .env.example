# Backend API Origin (no trailing slash).
# Example: https://api.quader864.ir or http://localhost:4000
# Ensure the frontend origin (e.g. http://localhost:3000) is included in the backend's ALLOWED_ORIGINS.
VITE_API_URL=https://api.quader864.ir

# Explicit USD-to-IRR (Iranian Rial) conversion rate for ZarinPal payment amounts.
# Catalog items are priced in USD; ZarinPal expects a positive integer in Rials (IRR).
VITE_IRR_PER_USD=2600000

# Optional Gemini API key (if server-side AI features are enabled)
GEMINI_API_KEY=
